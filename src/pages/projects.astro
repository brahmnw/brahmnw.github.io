---
import Layout from "../layouts/Layout.astro";
import Block from "../components/Block.astro";
import Header from "../components/Header.astro";
import Grid from "../components/Grid.astro";
import CardProject from "../components/CardProject.astro";
import CardAttrib from "../components/CardAttrib.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import { getCollection } from "astro:content";


const projects = await getCollection("moreProjects");
---



<Layout>
    <Header>projects</Header>

    <Block>
        <h3>my <span class="accent-dim">portfolio</span> &gt</h3>
        this page is a collection of my work in game dev, ux/ui, web dev, or graphic design!
    </Block>

    <Block theme="dark">
		<h3>featured work &gt;</h3>

		<FeaturedWork />
	</Block>

    <Block>
        <h3>other <span class="accent-dim">projects</span> &gt</h3>



        <Grid columns="1">
            {projects.map((project) => (
                <CardProject
                    title={project.data.title}
                    description={project.data.description}
                    link={project.data.link}
                    image={project.data.image}>
                        

                    <div class="horizontal" style="justify-content: flex-start;">
                        {project.data.tags.map((tag) => (
                            <CardAttrib>{tag}</CardAttrib>
                        ))}
                    </div>
                </CardProject>
            ))}

        </Grid>
        
    </Block>
</Layout>