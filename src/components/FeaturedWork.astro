---
import Grid from "./Grid.astro";
import Card from "./Card.astro";
import CardAttrib from "./CardAttrib.astro";
---

<Grid>
	<Card title="eggBEATer" description="a cute rhythm game rpg">
		<div class="horizontal">
			<CardAttrib>godot</CardAttrib>
			<CardAttrib>c#</CardAttrib>
			<CardAttrib>ux/ui</CardAttrib>
			<CardAttrib>game dev</CardAttrib>
		</div>
	</Card>

	<Card title="narawutti web" description="this website" image="/images/featured-thumb/site-thumb.png">
		<div class="horizontal">
			<CardAttrib>html/css</CardAttrib>
			<CardAttrib>ux/ui</CardAttrib>
			<CardAttrib>astro</CardAttrib>
			<CardAttrib>js</CardAttrib>
		</div>
	</Card>

	<Card title="Spellcast Showdown" description="bullethell roguelike with abilities" image="/images/featured-thumb/swf-thumb.png">
		<div class="horizontal">
			<CardAttrib>godot</CardAttrib>
			<CardAttrib>ux/ui</CardAttrib>
			<CardAttrib>illustration</CardAttrib>
		</div>
	</Card>

	<Card title="robomao" description="discord bot with text-based games" image="/images/featured-thumb/robomao-thumb.png">
		<div class="horizontal">
			<CardAttrib>discord.py</CardAttrib>
			<CardAttrib>async</CardAttrib>
			<CardAttrib>bot dev</CardAttrib>
		</div>
	</Card>

	<Card title="UBCEA web design" description="layout for esports club website" image="/images/featured-thumb/ubcea-thumb.png">
		<div class="horizontal">
			<CardAttrib>ux/ui</CardAttrib>
			<CardAttrib>graphic design</CardAttrib>
		</div>
	</Card>

	

	<Card title="naora" description="art vending and ecommerce" image="/images/featured-thumb/naora-thumb.png">
		<div class="horizontal">
			<CardAttrib>illustration</CardAttrib>
			<CardAttrib>graphic design</CardAttrib>
		</div>
	</Card>
</Grid>
