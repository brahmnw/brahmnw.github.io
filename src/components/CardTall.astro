---
const {
    title = "test",
    description = "test",
    image = "images/test.png",
    link = "/",
    colour = "var(--colour-favourites)",
} = Astro.props;
---

<a href={link} class="card" style={`--card-shadow-colour: ${colour};`}>
    <img class="card-image" src={image} />
    <div class="card-contents">
        <span class="card-title">{title}</span><br>
        <span class="card-description">{description}</span>
    </div>
    <div class="card-slots"><slot /></div>
    
</a>

<style>

.card {
    background-color: var(--theme-colour-dark);
    color: var(--theme-colour-light);
    border-radius: 0.75rem;
    padding: 1rem;

    transition: transform 0.2s ease-out;
    filter: drop-shadow(0px 4px 0px var(--card-shadow-colour));
    text-decoration: none;
}

.card:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0px 4px 0px var(--card-shadow-colour));
}

.card-image {
    width: 100%;
    height: 300px;
    border-radius: 0.75rem;
    object-fit: cover;
}

.card-title {
    font-size: 1rem;
    font-family: var(--font-header);
    text-align: center;
}

.card-description {
    font-size: 0.75rem;
}

.card-contents {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}

.card-slots {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

</style>
