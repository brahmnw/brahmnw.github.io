---
const {
    columns = 3,
    gap = "1.5rem"
} = Astro.props;
---

<div
    class="grid"
    style={`--columns: ${columns}; --gap: ${gap};`}
>
    <slot />
</div>

<style>

.grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--gap);
}


@media (max-width: 600px) {
    .grid {
        grid-template-columns: 1fr;
    }
}

</style>