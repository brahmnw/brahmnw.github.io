---
const {
    title = "test",
    table = "?",
    location = "No location",
    date = "No date",
    link="/",
    image = "/images/test.png"
} = Astro.props;
---

<a href={link} class="card">
    <img class="card-image" src={image} />
    <div class="card-contents">
        <span class="card-title">{title}</span><br>
        <span class="card-title">@ {table}</span><br>
        <span class="card-description">{location}</span>
    </div>
    <span class="card-description"><i>{date}</i></span>
</a>

<style>

.card {
    background-color: #ABABAB;
    color: #000000;
    padding: 1rem;
    font-family: "Spectral", serif;
    transition: transform 0.2s ease-out;
    text-decoration: none;
}

.card:hover {
    transform: translateY(-2px);
}

.card-image {
    width: 100%;
    height: 300px;
    object-fit: cover;
}

.card-title {
    font-size: 1.5rem;
    font-weight: 700;
}

.card-description {
    font-size: 1rem;
}

.card-contents {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}


</style>
