---
const {
    title = "test",
    description = "test",
    colour = "var(--theme-colour-accent-dim)",
} = Astro.props;
---

<div class="card" style={`--card-shadow-colour: ${colour};`}>
    <div class="card-contents">
        <span class="card-title">{title}</span><br>
        <span class="card-description">{description}</span>
    </div>
    <div class="card-slots"><slot /></div>
    
</div>

<style>

.card {
    background-color: var(--theme-colour-light);
    color: var(--theme-colour-dark);
    border-radius: 0.75rem;
    padding: 1rem;

    transition: transform 0.2s ease-out;
    filter: drop-shadow(0px 4px 0px var(--card-shadow-colour));
}

.card:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0px 4px 0px var(--card-shadow-colour));
}

.card-image {
    width: 100%;
    height: 200px;
    border-radius: 0.75rem;
    object-fit: cover;
}

.card-title {
    font-size: 1.5rem;
    font-family: var(--font-header);
}

.card-description {
    font-size: 1rem;
}

.card-contents {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}

.card-slots {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

</style>
