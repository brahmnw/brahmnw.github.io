---
const {
    title = "test",
    description = "test",
    link = "/projects/",
    image = "/images/test.png",
    colour = "var(--theme-colour-accent-dim)",
} = Astro.props;
---

<a href={link} class="card" style={`--card-shadow-colour: ${colour};`}>

    <div class="card-image" style={`background-image: url("${image}")`}></div>

    <div>
        <div class="card-contents">
            <span class="card-title">{title}</span><br>
            <span class="card-description">{description}</span>
        
        </div>
    
        <div class="card-slots"><slot /></div>
    </div>
    
</a>

<style>

.card {

    display: flex;
    flex-direction: row;
    justify-content: left;
    align-items: stretch;
    gap: 1.5rem;

    background-color: var(--theme-colour-dark);
    color: var(--theme-colour-light);
    border-radius: 0.75rem;
    padding: 1rem;

    transition: transform 0.2s ease-out;
    filter: drop-shadow(0px 4px 0px var(--card-shadow-colour));
    text-decoration: none;
}

.card:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0px 6px 0px var(--card-shadow-colour));
}

.card-image {
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    height: auto;
    border-radius: 0.75rem;
    object-fit: cover;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.card-title {
    font-size: 1.5rem;
    font-family: var(--font-header);
}

.card-description {
    font-size: 1rem;
}

.card-contents {
    display: flex;
    flex-direction: column;
    justify-content: left;
    align-items: left;

    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}

.card-slots {
    display: flex;
    flex-direction: column;
    justify-content: left;
    align-items: left;
}

</style>
