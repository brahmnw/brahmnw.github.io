---
const { 
    theme = "dark", 
    link = "/"
} = Astro.props;
---

<a href=`${link}` class="button-text">
    <div class=`button ${theme}`>
        <b><slot /></b>
        <img class="arrow" src="../src/assets/ui/arrow-right.svg">
    </div>
</a>



<style>

.button-text {
    text-decoration: none;
}

.button-text:hover {
    font-size: 1rem;
}

.button {
    padding-top: 0.1rem;
    padding-bottom: 0.1rem;
    padding-left: 1rem;
    padding-right: 1rem;
    display: flex;
    align-items: center;
    padding-inline: 1rem;
    border-radius: 2rem;
    width: fit-content;
    height: 1.5rem;
    gap: 0.75rem;
    font-size: 1rem;   
}

.button:hover {
    transform: scale(1.02);
    transition: transform 0.2s ease-out;
}

.dark {
    background-color: var(--theme-colour-dark);
    color: var(--theme-colour-light);
    
}

</style>
